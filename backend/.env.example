# ==============================================================================
# Database Configuration
# ==============================================================================
# Entropy: Strong password required in staging/production (>= 24 characters).
# Generation: openssl rand -hex 24
DATABASE_URL=postgresql://user:password@localhost:5432/ajo

# ==============================================================================
# Authentication & Secrets Management (JWT)
# ==============================================================================
# MINIMUM ENTROPY: Minimum 256 bits (32 bytes / 64 hex characters) of cryptographically
# secure randomness. Weak secrets (<32 bytes) are vulnerable to offline brute-force attacks.
#
# GENERATION:
#   openssl rand -base64 32
#   - OR -
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ROTATION POLICY:
#   Rotate at least every 90 days or immediately upon suspected credential compromise.
#   Soroban Ajo supports zero-downtime dual-secret rotation:
#   1. Set the newly generated secret as JWT_SECRET (all new tokens are signed with this).
#   2. Set the outgoing secret as JWT_SECRET_PREVIOUS (existing tokens continue to verify).
#   3. Once active token TTL (e.g. 7 days) elapses, clear JWT_SECRET_PREVIOUS.
#   See docs/SECRETS_MANAGEMENT.md for the full rotation runbook.
JWT_SECRET=
JWT_SECRET_PREVIOUS=
JWT_SECRET_FALLBACKS=
JWT_EXPIRES_IN=7d
TWO_FACTOR_CHALLENGE_EXPIRES_IN=5m

# Admin Authentication
# Optional dedicated admin secret. If unset, defaults to JWT_SECRET.
# Generation: openssl rand -base64 32
ADMIN_JWT_SECRET=

# ==============================================================================
# Redis (Job Queues, Caching, Rate Limiting, Realtime Sync)
# ==============================================================================
# Generation for password: openssl rand -hex 24
REDIS_URL=redis://localhost:6379

# Legacy discrete vars — not currently read by services
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==============================================================================
# Third-Party Integrations
# ==============================================================================
# Email (SendGrid API Key)
SENDGRID_API_KEY=
EMAIL_FROM=noreply@ajo.app

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Push Notifications (Firebase Cloud Messaging)
FCM_SERVER_KEY=

# Webhook Signing Secret (Used for HMAC SHA-256 outbound webhook verification)
# Generation: openssl rand -hex 32
WEBHOOK_SIGNING_SECRET=

# ==============================================================================
# Stellar / Soroban Network Configuration
# ==============================================================================
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
SOROBAN_CONTRACT_ID=
# Fee-paying "keeper" key used to submit permissionless execute_payout calls
# (holds no group funds — the contract transfers from its own escrow balance).
# Generation: stellar keys generate --network testnet
SOROBAN_KEEPER_SECRET=

# ==============================================================================
# Server & Environment
# ==============================================================================
FRONTEND_URL=http://localhost:3000
PORT=3001
NODE_ENV=development
